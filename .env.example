# Public site (fill before go-live — see docs/04-go-live.md)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# Contact (site + WhatsApp CTA)
NEXT_PUBLIC_WHATSAPP_E164=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Privacy / RODO controller
NEXT_PUBLIC_OPERATOR_LEGAL_NAME=
NEXT_PUBLIC_OPERATOR_NIP=
NEXT_PUBLIC_OPERATOR_ADDRESS=

# Mail (production fail-closed)
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=POL-TURK <noreply@your-domain.pl>
# RESEND_API_KEY=

# Operator panel
PANEL_PASSWORD=
PANEL_AUTH_SECRET=
# Reverse proxy hop count for X-Forwarded-For (Plesk/nginx: 1)
TRUSTED_PROXY_HOPS=1

# Customer portal (session HMAC — prod zorunlu). Giriş: e-posta + şifre; magic link = sıfırlama.
CUSTOMER_AUTH_SECRET=

# Stripe (production fail-closed) — sadece tahsilat; Dashboard invoice/receipt e-postaları KAPALI
# Live: sk_live_…  Test: sk_test_…  (--strict and NODE_ENV=production reject sk_test_)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
PACKAGE_CURRENCY=pln

# Yasal fatura: Stripe odeme + yerel PDF/SMTP (varsayilan). docs/51-stripe-ksef-faturalar.md
INVOICE_PROVIDER=local
# INVOICE_AUTO_ISSUE=
INVOICE_VAT_RATE=zw
INVOICE_EXEMPT_TAX_KIND=Zwolnienie z VAT na podstawie art. 113 ust. 1 ustawy o VAT
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ROUTEPOL <faktury@your-domain.pl>
# SELLER_NAME=
# SELLER_ADDRESS=
# SELLER_CITY=
# SELLER_PLACE=
# SELLER_NIP=
# SELLER_PESEL=
# SELLER_BANK_ACCOUNT=
# FAKTUROWNIA_ACCOUNT=
# FAKTUROWNIA_API_TOKEN=

# Durable files
# Plesk (önerilen): disk
STORAGE_BACKEND=fs
# STORAGE_ROOT=/var/www/vhosts/YOUR_DOMAIN/private/pol-turk-data
# Vercel Blob (alternatif):
# BLOB_READ_WRITE_TOKEN=

# Yerel: boş bırak → dosya deposu. Canlı: Plesk PostgreSQL (Docker değil).
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB?sslmode=require

# Cron (günlük cleanup + outbox + yenileme hatırlatma)
# CRON_SECRET=

# Opsiyonel hata izleme (Faz 3.9)
# SENTRY_DSN=
